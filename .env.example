# Copy to .env (same folder as docker-compose.yml) and fill in the key.
# Never commit .env or paste it into chat.
DEMO_MODE=true
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Vision checks (logo, style, prohibited visuals). Optional.
# Gemini has a vision model; Groq does not. Leave VLM_API_KEY empty to skip the VLM.
VLM_PROVIDER=gemini
VLM_API_KEY=
VLM_MODEL=
